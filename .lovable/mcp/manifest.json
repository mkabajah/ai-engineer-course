          "properties": {
            "stage": {
              "description": "Optional stage filter, e.g. 'passed' or 'accepted_paid'.",
              "type": "string",
              "maxLength": 40
            },
            "limit": {
              "description": "Max rows (default 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
