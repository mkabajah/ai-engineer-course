          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_challenge_results",
        "title": "Get challenge results",
        "description": "Admin only: list participant submissions or exam attempts with scores for one challenge.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "description": "Challenge slug, e.g. '1' or 'claude-architect'."
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_applicants",
        "title": "List applicants",
        "description": "Admin only: list course applicants with stage and AI total score, optionally filtered by stage.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
